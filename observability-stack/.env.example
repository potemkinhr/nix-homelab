# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThis!

# Management URLs
# If you expose this stack via Nginx Proxy Manager, Traefik, or Cloudflare, 
# update these to your HTTPS domains (e.g., https://grafana.yourdomain.com).
# If you are just testing locally, leave them as localhost.
GRAFANA_ROOT_URL=http://localhost:3000
PROMETHEUS_ROOT_URL=http://localhost:9090
